# The names the Core CLI reads, with no values in them.
#
# Copy this to `.env` on the machine that runs the demo and fill it there. `.env`
# is ignored by Git for a reason: a key that reaches a commit, a log line or a run
# document is a leaked credential, and the run document is evidence other people
# read.
#
# `.env` is loaded once, at the process boundary (`minekin_core.bootstrap.main`),
# into the environment every other module already reads. A name the shell already
# exported wins over the file, and `MINEKIN_ENV_FILE` points the loader somewhere
# other than `./.env` — which is how a container that mounts the repository
# read-only at `/src` is given its own copy.

# Where the Kin's data lives and which account the world admits.
MINEKIN_HOME=
MINEKIN_USERNAME=
MINEKIN_KIN_ID=
MINEKIN_JAVA=
MINEKIN_PERSONA_SEED=

# The model provider a decision is asked of. `off` — the default — never contacts
# anything and every ask answers `MODEL_NOT_CONFIGURED`, so a half-filled block
# like this one cannot spend anything.
#
# The key is never a field here: `MINEKIN_MODEL_API_KEY_ENV` names the variable
# that holds it, and the line below is that variable.
MINEKIN_MODEL_PROVIDER=off
MINEKIN_MODEL_BASE_URL=
MINEKIN_MODEL=
MINEKIN_MODEL_API_KEY_ENV=
MINEKIN_MODEL_TIMEOUT_MS=8000
MINEKIN_MODEL_RUN_COST_CAP=
MINEKIN_COMMANDCODE_API_KEY=

# The Jev decision provider is a planned, optional provider (S3-E). Nothing in
# Core reads this name yet; it is here so the credential has a home before the
# adapter does.
MINEKIN_JEV_API_KEY=
