{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minekin.local/schemas/server-profile.v1.json",
  "title": "Minekin controlled server profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "host", "port", "auth_mode", "minecraft_version", "visibility", "resource_pack_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "host": {"enum": ["127.0.0.1", "::1"]},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "auth_mode": {"const": "offline"},
    "minecraft_version": {"const": "1.21.4"},
    "visibility": {"const": "isolated_test_only"},
    "resource_pack_policy": {"enum": ["deny", "prompt"]}
  }
}
