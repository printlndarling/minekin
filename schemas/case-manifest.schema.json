{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minekin.local/schemas/case-manifest.v1.json",
  "title": "Minekin P0 case manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "work_package", "mandatory", "inputs", "assertions"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"},
    "work_package": {
      "description": "The work package this case is evidence for. W00-W80 are the phases of the core slice; the last three are the surfaces the validation contract grades independently.",
      "enum": [
        "W00",
        "W10",
        "W20",
        "W30",
        "W40",
        "W50",
        "W60",
        "W70",
        "W80",
        "p0-core",
        "p0-nav-exp",
        "host-integrated"
      ]
    },
    "mandatory": {"type": "boolean"},
    "inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "input_digests": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "assertion_digests": {
      "description": "Assertion name -> sha256 of the source that performs it. It is in the manifest so that the case version covers the criteria and not only their names.",
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "oracle_inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
